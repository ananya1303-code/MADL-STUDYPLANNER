package com.example.studyplannerapplication

import android.app.TimePickerDialog
import android.os.Bundle
import androidx.appcompat.app.AppCompatActivity
import com.example.studyplannerapplication.databinding.ActivityNotificationsBinding
import java.util.*

class NotificationActivity : AppCompatActivity() {

    private lateinit var binding: ActivityNotificationsBinding
    private lateinit var pref: PrefManager

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityNotificationsBinding.inflate(layoutInflater)
        setContentView(binding.root)

        pref = PrefManager(this)

        // Load saved state
        binding.switchNotify.isChecked = pref.isNotificationEnabled()
        binding.tvTime.text = "Time: ${pref.getTime()}"

        binding.switchNotify.setOnCheckedChangeListener { _, isChecked ->
            pref.setNotificationEnabled(isChecked)
        }

        binding.btnTime.setOnClickListener {
            showTimePicker()
        }
    }

    private fun showTimePicker() {
        val cal = Calendar.getInstance()

        val dialog = TimePickerDialog(
            this,
            { _, hour, minute ->
                val time = String.format("%02d:%02d", hour, minute)
                binding.tvTime.text = "Time: $time"
                pref.saveTime(time)
            },
            cal.get(Calendar.HOUR_OF_DAY),
            cal.get(Calendar.MINUTE),
            true
        )
        dialog.show()
    }
}


