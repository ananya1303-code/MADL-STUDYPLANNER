package com.example.studyplannerapplication

import android.app.AlertDialog
import android.os.Bundle
import android.widget.ArrayAdapter
import android.widget.EditText
import androidx.appcompat.app.AppCompatActivity
import com.example.studyplannerapplication.databinding.ActivityPlannerBinding

class PlannerActivity : AppCompatActivity() {

    private lateinit var binding: ActivityPlannerBinding
    private val tasks = mutableListOf<String>()
    private lateinit var adapter: ArrayAdapter<String>
    private lateinit var pref: PrefManager

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityPlannerBinding.inflate(layoutInflater)
        setContentView(binding.root)

        pref = PrefManager(this)

        adapter = ArrayAdapter(this, android.R.layout.simple_list_item_multiple_choice, tasks)
        binding.listTasks.adapter = adapter
        binding.listTasks.choiceMode = 2

        binding.btnAdd.setOnClickListener { showDialog() }

        binding.listTasks.setOnItemClickListener { _, _, _, _ ->
            pref.saveTasksCompleted(binding.listTasks.checkedItemCount)
        }
    }

    private fun showDialog() {
        val input = EditText(this)

        AlertDialog.Builder(this)
            .setTitle("Add Task")
            .setView(input)
            .setPositiveButton("Add") { _, _ ->
                tasks.add(input.text.toString())
                adapter.notifyDataSetChanged()
            }
            .setNegativeButton("Cancel", null)
            .show()
    }
}




